                "tags": [
                    "Products"
                ],
                "parameters": [
                    {
                        "name": "api-version",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ProductV2"
                            }
                        },
                        "text/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ProductV2"
                            }
                        },
                        "application/*+json": {
